# Vercel deployment ignore list (gitignore syntax).
# Applied at upload stage (before build); anything the build needs must stay.

# Dev / verification tools (hundreds of temp PNG frames under tools/tmp/)
tools/

# Source audio wavs — frontend fetches the base64 bundle public/audio-data.json, never uses audio/*.wav
audio/

# audio-data.js is only the conversion source for audio-data.json (scripts/convert-audio-data-to-json.mjs);
# the frontend loads audio-data.json via fetch, so the .js bundle is not uploaded.
public/audio-data.js

# Design docs (markdown, not rendered on Vercel)
docs/

# Local-only Node server and launcher scripts (Vercel uses api/ + lib/, not these)
scripts/server.js
start.bat
1git.bat

# atlas 压缩前的原图备份（仅本地回滚用，不部署到 Vercel）
public/Image/*.orig.webp
